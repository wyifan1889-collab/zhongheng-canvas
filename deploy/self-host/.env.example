# Copy to .env in this directory for one local instance. Do not commit it.
# Use matching Web and API references from the release; include @sha256:...
CANVAS_WEB_IMAGE=
CANVAS_API_IMAGE=
# PostgreSQL 16 from the release, also pinned by digest.
CANVAS_DB_IMAGE=
# Generate a unique value: openssl rand -hex 32
CANVAS_DB_PASSWORD=
CANVAS_PORT=3000

# Accounts are optional for the loopback smoke test. See README before enabling.
CANVAS_ACCOUNTS_ENABLED=false
CANVAS_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_TIMEOUT_MS=10000
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
