HOST=127.0.0.1
PORT=4000

# 默认关闭。只对独立画布库执行显式 db:migrate；不要填入 Sub2API 生产配置。
# 本地 Vite 页面默认在 4180，通过 VITE_API_TARGET=http://127.0.0.1:4000
# 代理到 API；SAAS_ORIGIN 填浏览器实际访问的同源地址，而不是 API 监听端口。
SAAS_ACCOUNTS_ENABLED=false
SAAS_CLOUD_CANVAS_ENABLED=false
# 仅当 API 只绑定回环地址、由可信 HTTPS 反代终止 TLS 时设为 true；不要把 API 端口直接暴露公网。
SAAS_TRUSTED_PROXY=false
# 仅开放账号级手动全媒体空间时开启；不等于开放云画布正文保存。
SAAS_MEDIA_ENABLED=false
# 图片生成 API 默认关闭；开启前须账号、云媒体/私有存储及已安装的 canvas_jobs.generation 队列就绪。
# API 仅启动 producer，不自动安装队列、迁移或启动 worker；真实渠道/价格另行确认。
SAAS_GENERATION_IMAGE_ENABLED=false
# 文本生成独立开关；开启前须完成 0024、已安装队列及已发布的双项文本价目。
# 按用户确认预算冻结，完整用量实耗结算；超预算/缺用量待核对，不追加扣款。
SAAS_GENERATION_TEXT_ENABLED=false
# TTS独立开关：0027音频按次价目、账号私有媒体与既有生成队列就绪后显式开放。
# 只提供已实现的OpenAI-compatible Speech；真实中转协议仍须单独验收。
SAAS_GENERATION_AUDIO_ENABLED=false
SAAS_DATABASE_URL=
SAAS_ORIGIN=http://127.0.0.1:4180
SAAS_AUTH_SECRET=
# 可选：服务器私有的首个超管邮箱。仅已验证的匹配账户会被提升为 admin。
# SAAS_ADMIN_EMAIL=owner@example.com
# 可选：服务器私有媒体目录；仅配置后端适配器，不会自动开启上传路由。
# SAAS_STORAGE_ROOT=/srv/infinite-canvas/storage
# 可选：真实阿里云 OSS 适配器；仅在已创建私有 Bucket、配置最小权限并准备真实凭据后填写。
# STORAGE_PROVIDER=aliyun-oss
# ALIYUN_OSS_REGION=oss-cn-shanghai
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=infinite-canvas-dev
# 云媒体默认额度与单文件上限；只有明确开启 SAAS_MEDIA_ENABLED 后才会挂载上传路由。
# STORAGE_QUOTA_BYTES=1073741824
# STORAGE_IMAGE_MAX_BYTES=10485760
# STORAGE_VIDEO_MAX_BYTES=104857600
# STORAGE_AUDIO_MAX_BYTES=104857600

# QQ 邮箱示例：smtp.qq.com / 465 / true；SMTP_PASSWORD 填授权码，不是 QQ 登录密码。
# SMTP 必须支持 TLS；不禁用证书验证，不自动重发。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 外部服务等待值须明确配置；没有隐式默认，单位毫秒。
# 已确认：验证码 10 秒，SMTP 连接/握手 10 秒、发送无响应 30 秒；不自动重试。
# 超时提示未完成/发送未确认，不代表邮件一定未发出。仅填写样例不会开启账户。
CAPTCHA_TIMEOUT_MS=10000
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# 生成 worker 默认关闭。仅在独立 staging/production worker 进程中显式填写；
# API server 仅在上方图片开关开启时读取 QUEUE_URL，不自动启动 worker。启用前必须先安装 canvas_jobs schema，
# 审查队列重试/租约和 Provider/交付/结算策略，再由独立进程显式调用 runtime.start()。
# GENERATION_WORKER_ENABLED=false
# GENERATION_WORKER_ENVIRONMENT=staging
# QUEUE_URL 必须与 SAAS_DATABASE_URL 的主机/端口/数据库相同，schema 固定为 canvas_jobs。
# GENERATION_WORKER_QUEUE_URL=postgresql://worker_user:password@127.0.0.1/infinite_canvas
# GENERATION_WORKER_MAX_BATCH_SIZE=20
# Provider 调用沿用现有超时；不会因图片调用自动延长或重试。
# GENERATION_WORKER_PROVIDER_TIMEOUT_MS=30000
# 图片生成另行显式开启，默认关闭。需要同一账号私有存储的 STORAGE_PROVIDER 及相应配置。
# 当前仅支持 OpenAI 兼容、单张 Base64 PNG、按 request 计费；URL 返回或结果不明进入待核对。
# 先确认实际渠道协议/价格并完成 API 入队和画布接线；此开关不自动开放网页生成。
# GENERATION_WORKER_IMAGE_ENABLED=false
# TTS worker另行显式开启，复用私有存储；完整MP3/WAV交付成功按已发布固定积分结算。
# 失败释放；超时/响应或交付未知保留核对，不自动重复调用Speech。
# GENERATION_WORKER_AUDIO_ENABLED=false
